# Ruta base de la API — en dev usa el proxy de Vite, en prod poner URL completa
VITE_API_BASE=/api

# URL del proyecto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=your_supabase_project_url

# Clave anónima de Supabase (Project Settings > API > anon public key)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# WebSocket URL — opcional en dev, necesario en prod
# VITE_WS_URL=wss://api.yourdomain.com/ws
